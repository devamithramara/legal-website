// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  JUNIOR
  INTERN
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CaseStatus {
  INTAKE
  ACTIVE
  ARGUED
  JUDGMENT
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum RecipientType {
  CLIENT
  JUNIOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  role         Role     @default(CLIENT)
  designation  String?  // e.g. "Junior Advocate", "Intern"
  password     String
  createdAt    DateTime @default(now())

  appointments      Appointment[]
  clientCases       Case[]            @relation("ClientCases")
  juniorCases       Case[]            @relation("JuniorCases")
  juniorTasks       Task[]            @relation("JuniorTasks")
  seniorTasks       Task[]            @relation("SeniorTasks")
  documents         Document[]
  invoices          Invoice[]
  testimonials      Testimonial[]
  hearingReminders  HearingReminder[]
  timeLogs          TimeLog[]
  dailyLogs         DailyLog[]
  appearances       Appearance[]
  drafts            Draft[]
  researchLogs      ResearchLog[]
  clientCallLogs    ClientCallLog[]
  escalationsRaised Escalation[]      @relation("EscalationRaisedBy")
  learningItems     LearningItem[]    @relation("LearningJunior")
  assignedLearning  LearningItem[]    @relation("LearningAssignedBy")
  skillTags         SkillTag[]        @relation("JuniorSkillTags")
}

model Appointment {
  id        String            @id @default(uuid())
  clientId  String
  client    User              @relation(fields: [clientId], references: [id])
  date      DateTime
  timeSlot  String
  caseType  String
  status    AppointmentStatus @default(PENDING)
  paymentId String?
  feePaid   Float
  notes     String?
  createdAt DateTime          @default(now())

  documents Document[]
}

model Case {
  id          String     @id @default(uuid())
  clientId    String
  client      User       @relation("ClientCases", fields: [clientId], references: [id])
  assignedTo  String?
  junior      User?      @relation("JuniorCases", fields: [assignedTo], references: [id])
  caseNumber  String     @unique
  title       String
  type        String
  status      CaseStatus @default(INTAKE)
  nextHearing DateTime?
  court       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events           CaseEvent[]
  documents        Document[]
  tasks            Task[]
  hearingReminders HearingReminder[]
  appearances      Appearance[]
  drafts           Draft[]
  researchLogs     ResearchLog[]
  clientCallLogs   ClientCallLog[]
  escalations      Escalation[]
}

model CaseEvent {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventDate DateTime
  title     String
  notes     String?
  createdAt DateTime @default(now())
}

model Document {
  id            String       @id @default(uuid())
  uploadedById  String
  uploadedBy    User         @relation(fields: [uploadedById], references: [id])
  caseId        String?
  case          Case?        @relation(fields: [caseId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  name          String
  url           String
  type          String       // e.g., ID Proof, Contract, Court Notice, Draft, Other
  createdAt     DateTime     @default(now())
}

model Invoice {
  id        String        @id @default(uuid())
  clientId  String
  client    User          @relation(fields: [clientId], references: [id])
  amount    Float
  gstNumber String?
  status    InvoiceStatus @default(UNPAID)
  pdfUrl    String?
  createdAt DateTime      @default(now())
  dueDate   DateTime?
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  category    String   // Rent, Salary, Office Supplies, Marketing, Other
  date        DateTime @default(now())
  description String?
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // INFLOW, OUTFLOW
  amount      Float
  category    String
  date        DateTime @default(now())
  referenceId String?
  description String?
}

model Task {
  id            String     @id @default(uuid())
  caseId        String
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedTo    String
  junior        User       @relation("JuniorTasks", fields: [assignedTo], references: [id])
  assignedBy    String?
  senior        User?      @relation("SeniorTasks", fields: [assignedBy], references: [id])
  title         String
  type          String     @default("RESEARCH") // DRAFT | RESEARCH | FILING | COURT | CLIENT_CALL | TRAVEL
  priority      String     @default("NORMAL")   // URGENT | NORMAL | LOW
  status        String     @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | REVIEW | DONE
  deadline      DateTime?
  notes         String?
  rating        Int?       // 1-5 senior feedback rating
  feedback      String?    // senior feedback note
  billableHours Float      @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  timeLogs  TimeLog[]
  documents Document[]
}

model TimeLog {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  juniorId    String
  junior      User      @relation(fields: [juniorId], references: [id])
  category    String    @default("RESEARCH") // RESEARCH | DRAFTING | COURT | CLIENT | FILING | TRAVEL
  startTime   DateTime
  endTime     DateTime?
  duration    Float?    // hours, calculated on stop
  description String?
  approved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model DailyLog {
  id             String    @id @default(uuid())
  juniorId       String
  junior         User      @relation(fields: [juniorId], references: [id])
  date           DateTime
  tasksCompleted String[]  // task IDs
  hoursWorked    Float
  courtVisited   Boolean   @default(false)
  issues         String?
  escalate       Boolean   @default(false)
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model Appearance {
  id         String    @id @default(uuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  juniorId   String
  junior     User      @relation(fields: [juniorId], references: [id])
  date       DateTime
  court      String
  hallNumber String?
  timeIn     DateTime?
  timeOut    DateTime?
  outcome    String    @default("ADJOURNED") // ADJOURNED | ARGUMENTS | ORDER | PART_HEARD
  nextDate   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
}

model Draft {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  juniorId  String
  junior    User     @relation(fields: [juniorId], references: [id])
  title     String
  type      String   @default("PETITION") // PETITION | AFFIDAVIT | NOTICE | WRITTEN_STATEMENT | VAKALATNAMA
  status    String   @default("DRAFT")    // DRAFT | UNDER_REVIEW | APPROVED | FILED | REDO
  version   Int      @default(1)
  fileUrl   String   // Cloudinary URL
  comments  String?  // senior inline comments
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ResearchLog {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  juniorId  String
  junior    User     @relation(fields: [juniorId], references: [id])
  sections  String[] // IPC sections referred
  citations String[] // case law citations
  source    String   @default("SCC") // SCC | MANUPATRA | INDIANKANOON | BARE_ACT
  summary   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ClientCallLog {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  juniorId    String
  junior      User     @relation(fields: [juniorId], references: [id])
  clientId    String
  date        DateTime @default(now())
  duration    Int      // minutes
  summary     String
  actionItems String[]
  escalate    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Escalation {
  id          String    @id @default(uuid())
  caseId      String
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  raisedBy    String
  junior      User      @relation("EscalationRaisedBy", fields: [raisedBy], references: [id])
  reason      String    @default("STRATEGY") // UNREACHABLE_CLIENT | UNEXPECTED_FILING | STRATEGY | OTHER
  description String
  status      String    @default("OPEN")     // OPEN | ACKNOWLEDGED | RESOLVED
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model LearningItem {
  id         String   @id @default(uuid())
  juniorId   String
  junior     User     @relation("LearningJunior", fields: [juniorId], references: [id])
  assignedBy String
  senior     User     @relation("LearningAssignedBy", fields: [assignedBy], references: [id])
  title      String
  type       String   @default("BARE_ACT") // BARE_ACT | JUDGMENT | PROCEDURE | VIDEO | NOTE
  content    String   // URL or text
  summary    String?  // junior's 3-line summary after reading
  status     String   @default("ASSIGNED") // ASSIGNED | READ | REVIEWED | REDO
  createdAt  DateTime @default(now())
}

model Template {
  id        String   @id @default(uuid())
  title     String
  type      String   @default("BAIL") // BAIL | STAY | NOTICE | VAKALATNAMA | WRITTEN_STATEMENT
  fileUrl   String
  createdBy String
  createdAt DateTime @default(now())
}

model SkillTag {
  id        String   @id @default(uuid())
  juniorId  String
  junior    User     @relation("JuniorSkillTags", fields: [juniorId], references: [id])
  tag       String   // CRIMINAL | CIVIL | PROPERTY | FAMILY | CORPORATE | RESEARCH
  addedBy   String
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  clientId  String
  client    User     @relation(fields: [clientId], references: [id])
  rating    Int
  body      String
  caseType  String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model HearingReminder {
  id            String         @id @default(uuid())
  caseId        String
  case          Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recipientId   String
  recipient     User           @relation(fields: [recipientId], references: [id])
  recipientType RecipientType
  channel       String         @default("SMS")
  message       String
  sentAt        DateTime?
  status        ReminderStatus @default(PENDING)
  scheduledFor  DateTime?
  createdAt     DateTime       @default(now())
}

model ReminderSetting {
  id                String   @id @default(uuid())
  daysBeforeHearing Int      @default(1)
  morningOfHearing  Boolean  @default(true)
  customMessage     String?
  updatedAt         DateTime @updatedAt
}
